---
layout: layouts/base.njk
ogType: article
---
<main id="main" class="wrap page-hero">
  <nav class="crumbs" aria-label="Breadcrumb">
    <ol>
      <li><a href="/">Home</a></li>
      <li><a href="/{{ silo }}/">{{ siloName }}</a></li>
      <li aria-current="page">{{ title }}</li>
    </ol>
  </nav>
  <p class="eyebrow">{{ siloName }}</p>
  <h1>{{ title }}</h1>
  <p class="dek">{{ dek }}</p>
  {% set namedAuthor = author.name if author and author.name and "[" not in author.name else "" %}
  <p class="byline">
    <span>By {{ namedAuthor or "Dispatch Cove" }}</span>
    <span>Published {{ date | prettyDate }}</span>
    {% if updated | isoDate != date | isoDate %}
      <span>Updated {{ updated | prettyDate }}</span>
    {% else %}
      <span>Reviewed {{ date | prettyDate }}</span>
    {% endif %}
    <span>{{ readTime }}</span>
  </p>
  <div class="article-grid">
    <figure class="frame article-hero">
      <img
        src="{{ hero }}-800.webp"
        srcset="{{ hero }}-800.webp 800w, {{ hero }}-1600.webp 1600w"
        sizes="(min-width: 1040px) 40rem, calc(100vw - 2.5rem)"
        alt="{{ heroAlt }}"
        width="1600"
        height="{{ heroHeight }}"
        fetchpriority="high"
        decoding="async">
      <figcaption>{{ heroCaption }}</figcaption>
    </figure>
    <article class="prose">
      {{ content | withAffiliateNote | safe }}
      {% if faq %}
      <section class="faq" aria-labelledby="faq-title">
        <h2 id="faq-title">Questions people actually ask</h2>
        {% for item in faq %}
        <details>
          <summary>{{ item.q }}</summary>
          <p>{{ item.a }}</p>
        </details>
        {% endfor %}
      </section>
      {% endif %}
      <aside class="author">
        {% if namedAuthor %}
          {% if author.photo and "[" not in author.photo %}
          <img class="avatar" src="{{ author.photo }}" alt="" width="52" height="52">
          {% else %}
          <div class="avatar" aria-hidden="true">{{ namedAuthor[0] }}</div>
          {% endif %}
          <div>
            <h2>{{ namedAuthor }}</h2>
            {% if author.bio and "[" not in author.bio %}<p>{{ author.bio }}</p>{% endif %}
          </div>
        {% else %}
          <div class="avatar" aria-hidden="true">DC</div>
          <div>
            <h2>Dispatch Cove</h2>
            <p>Guides for U.S. truck dispatchers and owner-operators, published by {{ site.operator }}. We explain the job first. A product is mentioned only when it fits, the link is labeled, and we do not invent tests, statistics, or testimonials. This is general information, not legal, tax, insurance, or financial advice.</p>
          </div>
        {% endif %}
      </aside>
    </article>
    <nav class="toc" aria-label="On this page">
      <p class="kicker">On this page</p>
      <ol>
        {% for item in toc %}
        <li><a href="#{{ item.id }}">{{ item.label }}</a></li>
        {% endfor %}
        {% if faq %}<li><a href="#faq-title">Questions</a></li>{% endif %}
      </ol>
    </nav>
  </div>
</main>
{% if related and related.length %}
<section class="wrap related" aria-labelledby="related-title">
  <h2 id="related-title">Related guides</h2>
  <ul class="related-list">
    {% for item in related %}
    <li>
      <a href="{{ item.href }}">{{ item.title }}</a>
      {% if item.note %}<p>{{ item.note }}</p>{% endif %}
    </li>
    {% endfor %}
  </ul>
</section>
{% endif %}
{% set picks = collections.guide | recommend(page.url, silo) %}
{% if picks.length %}
<section class="wrap recommend" aria-labelledby="recommend-title">
  <h2 id="recommend-title">Recommended for you</h2>
  <div class="recommend-grid">
    {% for post in picks %}
    <a class="recommend-card" href="{{ post.url }}">
      <img
        src="{{ post.data.hero }}-800.webp"
        alt=""
        width="800"
        height="450"
        loading="lazy"
        decoding="async">
      <span>
        <span class="kicker">{{ post.data.siloName }}</span>
        <h3 class="recommend-title">{{ post.data.title }}</h3>
      </span>
    </a>
    {% endfor %}
  </div>
</section>
{% endif %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site.url }}/" },
        { "@type": "ListItem", "position": 2, "name": {{ siloName | dump | safe }}, "item": "{{ site.url }}/{{ silo }}/" },
        { "@type": "ListItem", "position": 3, "name": {{ title | dump | safe }}, "item": "{{ site.url }}{{ page.url }}" }
      ]
    },
    {
      "@type": "Article",
      "headline": {{ title | dump | safe }},
      "description": {{ description | dump | safe }},
      "datePublished": "{{ date | isoDate }}",
      "dateModified": "{{ updated | isoDate }}",
      "inLanguage": "en-US",
      "articleSection": {{ siloName | dump | safe }},
      "mainEntityOfPage": "{{ site.url }}{{ page.url }}",
      "image": ["{{ site.url }}{{ hero }}-1600.webp"],
      {% if namedAuthor %}
      "author": {
        "@type": "Person",
        "name": {{ namedAuthor | dump | safe }}
      },
      {% else %}
      "author": { "@id": "{{ site.url }}/#organization" },
      {% endif %}
      "publisher": { "@id": "{{ site.url }}/#organization" }
    }{% if faq %},
    {
      "@type": "FAQPage",
      "mainEntity": [
        {% for item in faq %}
        {
          "@type": "Question",
          "name": {{ item.q | dump | safe }},
          "acceptedAnswer": {
            "@type": "Answer",
            "text": {{ item.a | dump | safe }}
          }
        }{% if not loop.last %},{% endif %}
        {% endfor %}
      ]
    }{% endif %}
  ]
}
</script>
